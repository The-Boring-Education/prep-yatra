{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/next"
        }
    ],
    "routes": [
        {
            "src": "/auth",
            "dest": "/auth"
        },
        {
            "src": "/dashboard",
            "dest": "/dashboard"
        },
        {
            "src": "/onboarding",
            "dest": "/onboarding"
        },
        {
            "src": "/pricing",
            "dest": "/pricing"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ]
}